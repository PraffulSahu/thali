{
  "name": "thali",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "tsc -b packages/* services/* && npm run build -w @thali/web",
    "typecheck": "tsc -b packages/* services/* e2e && npm run typecheck -w @thali/web",
    "test": "vitest run",
    "test:unit": "THALI_TEST_KIND=unit vitest run --passWithNoTests",
    "test:int": "THALI_TEST_KIND=int vitest run --passWithNoTests",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d --wait",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "dev": "bash scripts/dev.sh",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "npm run stack:up && npm run seed && npm run test -w @thali/e2e"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "3.2.7",
    "supertest": "7.3.1",
    "fast-check": "4.10.2",
    "@types/node": "22.20.5",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/cors": "2.8.19",
    "@types/cookie-parser": "1.4.10",
    "@types/swagger-ui-express": "4.1.8",
    "@types/nodemailer": "7.0.12"
  }
}
