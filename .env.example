# =====================================================================================================
# Thali environment template.   cp .env.example .env   (.env is git-ignored; never commit it)
#
# One file serves two purposes:
#   1. `npm run stack:up` (docker-compose.yml): compose reads this file for ${VAR} interpolation. The
#      compose file sets every container-topology value itself (MONGO_URI per service with its own DB
#      user, REDIS_URL, http://<svc>:<port> peer URLs, JWKS_URL, S3_ENDPOINT, MAILPIT_URL, TRUST_PROXY),
#      so the "local dev" values below are ignored inside the stack.
#   2. `npm run dev` (scripts/dev.sh): services run on the host with tsx watch against the infra stack
#      (docker-compose.infra.yml); this file is sourced as-is, so the localhost URLs below apply.
#
# Values marked `# SECRET` are demo-only placeholders: they make `cp .env.example .env` boot out of the box
# and protect nothing. Every one carries the marker `thali-demo-` (FIELD_ENCRYPTION_KEY decodes to bytes
# starting with it), and APP_MODE=production refuses to start with any value containing the marker.
# For anything other than a local demo, generate a .env with fresh random secrets:
#   scripts/gen-env.sh [.env]          (openssl rand; refuses to overwrite without --force)
# or by hand: openssl rand -base64 32 (FIELD_ENCRYPTION_KEY: base64 of exactly 32 bytes),
#             openssl rand -hex 32    (INTERNAL_SERVICE_SECRET, peppers, webhook secrets, passwords).
# Mongo passwords are embedded in connection URIs: keep them URL-safe (hex, '-').
#
# APP_MODE=production refuses: any *_PROVIDER=mock, any truthy DEMO_*, EMAIL_PROVIDER=mailpit,
# GEO_PROVIDER=demo, INTERNAL_SERVICE_SECRET shorter than 32 chars, missing JWT_PRIVATE_KEY_PEM, and any
# value containing the demo placeholder marker `thali-demo-`.
# =====================================================================================================

# ---------------------------------------------------------------- compose: host port map -------------
# Defaults match the documented ports. Override when they collide (e.g. the infra stack also binds
# 8025/9000/9001): MAILPIT_HOST_PORT=18025 MINIO_HOST_PORT=19000 MINIO_CONSOLE_HOST_PORT=19001
# Redis, Mongo and the six services are not published (see the `debug` profile in docker-compose.yml).
PUBLISH_ADDR=127.0.0.1           # host interface for published ports; 0.0.0.0 to expose on the LAN
WEB_HOST_PORT=5173               # web (nginx: SPA + /api proxy)
GATEWAY_HOST_PORT=8080           # API gateway (direct)
MAILPIT_HOST_PORT=8025           # Mailpit inbox UI + HTTP API
MINIO_HOST_PORT=9000             # MinIO S3 API (browser loads images / presigned URLs from here)
MINIO_CONSOLE_HOST_PORT=9001     # MinIO console
S3_PUBLIC_HOST=localhost         # host browsers use for MinIO URLs (presigned + public images); for LAN access set a LAN IP/hostname, PUBLISH_ADDR=0.0.0.0 and add the web origin to MINIO_CORS_ALLOW_ORIGIN

# ---------------------------------------------------------------- common (every service) -------------
APP_MODE=demo                    # demo | sandbox | production
LOG_LEVEL=info                   # pino level: fatal|error|warn|info|debug|trace
DOCS_ENABLED=true                # Swagger at /docs per service, aggregated at gateway /api/docs
PUBLIC_WEB_URL=http://localhost:5173   # SPA origin (links in emails, demo-pay URL, verify redirect)
PUBLIC_API_URL=http://localhost:8080   # public API base (webhook callback URLs, verify links)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # CSV of browser origins allowed (credentials on)
INTERNAL_SERVICE_SECRET=thali-demo-c2bce8dfb33f4d4f3ce9abf06456e43ebe67af324a43f3fe   # SECRET (>=16; >=32 in production) signs service-to-service tokens
FIELD_ENCRYPTION_KEY=dGhhbGktZGVtby1maWVsZGtleS0xZmMzMDVkYzQzMDc=   # SECRET base64 of 32 bytes (AES-256-GCM field encryption)
# EVENT_STREAM_PREFIX: optional Redis stream name prefix (tests use a unique one)
EVENT_STREAM_PREFIX=
REDIS_KEY_PREFIX=thali:          # Redis key prefix
# local dev only (compose overrides):
MONGO_URI="mongodb://localhost:27018/?replicaSet=rs0&directConnection=true"
REDIS_URL=redis://localhost:6379
TRUST_PROXY=loopback             # compose: 1 (one hop: nginx -> gateway, gateway -> service)
JWKS_URL=http://localhost:4001/.well-known/jwks.json
IDENTITY_URL=http://localhost:4001
MARKETPLACE_URL=http://localhost:4002
ORDERS_URL=http://localhost:4003
PAYMENTS_URL=http://localhost:4004
DELIVERY_URL=http://localhost:4005
NOTIFICATIONS_URL=http://localhost:4006

# ---------------------------------------------------------------- mongo (compose stack) --------------
# Replica set rs0 with auth + keyfile (keyfile generated into a volume on first start). The init job
# creates one user per service with readWrite on its own database only (thali_<service>).
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=thali-demo-442d2ba353ed16a8c3428820            # SECRET
MONGO_IDENTITY_PASSWORD=thali-demo-536cbbbeaf7e1f8b48477761        # SECRET user thali_identity
MONGO_MARKETPLACE_PASSWORD=thali-demo-f5466ae55c8ad5aa0cd81c89     # SECRET user thali_marketplace
MONGO_ORDERS_PASSWORD=thali-demo-f95609df20447eb9eacc5195          # SECRET user thali_orders
MONGO_PAYMENTS_PASSWORD=thali-demo-c9442862597e0a53b6b1c5ec        # SECRET user thali_payments
MONGO_DELIVERY_PASSWORD=thali-demo-f8bad058aff4789640507a94        # SECRET user thali_delivery
MONGO_NOTIFICATIONS_PASSWORD=thali-demo-bd6e63e16dc1cf79b14c64d4   # SECRET user thali_notifications

# ---------------------------------------------------------------- object storage (MinIO / S3) --------
# Compose: MinIO root credentials (services use them as S3 keys; buckets created by minio-init).
MINIO_ROOT_USER=thali
MINIO_ROOT_PASSWORD=thali-demo-8bfd93fad834ed0c6d06252e            # SECRET
STORAGE_PROVIDER=s3              # only s3 (AWS S3 or any S3-compatible endpoint)
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=thali-public    # images (anonymous read)
S3_PRIVATE_BUCKET=thali-private  # KYC documents (presigned access only)
# local dev only (infra stack MinIO; compose overrides endpoint, keys and public base URL):
S3_ENDPOINT=http://localhost:9000          # empty for AWS S3; set => path-style addressing
S3_ACCESS_KEY_ID=thali                     # SECRET-ish; omit both keys to use an IAM role
S3_SECRET_ACCESS_KEY=thali-dev-secret      # SECRET (infra stack's committed dev value)
S3_PUBLIC_BASE_URL=http://localhost:9000/thali-public   # public image base (CDN in production)
# S3_PUBLIC_ENDPOINT: browser-reachable endpoint used to sign presigned upload/download URLs when the
# services reach the store on a private host (compose: S3_ENDPOINT=http://minio:9000, this=http://localhost:9000).
# Empty = S3_ENDPOINT. Compose sets it to http://$S3_PUBLIC_HOST:$MINIO_HOST_PORT.
S3_PUBLIC_ENDPOINT=
# MINIO_CORS_ALLOW_ORIGIN: compose MinIO CORS (browser PUT/GET on presigned URLs); CSV of web origins
MINIO_CORS_ALLOW_ORIGIN=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------- geo (marketplace, delivery) --------
GEO_PROVIDER=demo                # google | demo (demo = haversine x ROAD_FACTOR; refused in production)
# GOOGLE_MAPS_API_KEY: SECRET required when GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=
ROAD_FACTOR=1.3                  # demo distance multiplier
AVG_SPEED_KMPH=20                # travel-time model

# ---------------------------------------------------------------- identity (port 4001) ---------------
# JWT_PRIVATE_KEY_PEM=           # SECRET Ed25519 PKCS#8 PEM (\n-escaped single line OK). Required in production; demo/sandbox auto-generate into the signing_keys collection
# JWT_PUBLIC_KEY_PEM=            # optional SPKI PEM; must match the private key
# JWT_KID=                       # optional kid (default RFC 7638 thumbprint)
ACCESS_TOKEN_TTL_SEC=900
OTP_PEPPER=thali-demo-ba1cdb160c71da0b34519b15e358e8b6   # SECRET (min 16) HMAC key for OTP code hashes
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_PER_HOUR=5               # per phone
OTP_MAX_PER_IP_PER_HOUR=20       # per IP (verify limit = 5x this)
OTP_MAX_ATTEMPTS=5
DEMO_OTP_ENABLED=true            # demo only (refused in production): code 123456 for DEMO_PHONES
# consumers +91900..., restaurant owners +91910..., delivery partners +91920...
DEMO_PHONES=+919000000001,+919000000002,+919000000003,+919100000001,+919100000002,+919200000001,+919200000002
SESSION_DAYS=30
ADMIN_SESSION_HOURS=12
REFRESH_REUSE_GRACE_SEC=10
# COOKIE_SECURE: empty = true unless APP_MODE=demo (demo is served over plain http)
COOKIE_SECURE=
CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080   # cookie endpoints (refresh/logout); empty = CORS_ORIGINS + PUBLIC_WEB_URL origin
ADMIN_LOGIN_MAX_PER_WINDOW=10    # per IP+email
ADMIN_LOGIN_WINDOW_SEC=900
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
TOTP_ISSUER=Thali
# Demo seed (npm run seed; APP_MODE=demo only): admin@thali.demo credentials, printed by the identity seed.
# SEED_ADMIN_PASSWORD: default ThaliDemo#2026 (min 12 chars)
# SEED_ADMIN_TOTP_SECRET: base32; default THALIDEMOTOTPSECRETKEY234567ABCD

# ---------------------------------------------------------------- marketplace (port 4002) ------------
REQUIRED_DOCUMENT_TYPES=FSSAI,GST,PAN   # KYC docs required before submitting a restaurant (CSV; empty = none)
MAX_DELIVERY_RADIUS_KM=15        # discovery candidate pre-filter
RESERVATION_GRACE_SEC=300        # a HELD stock/coupon reservation is left alone this long past expiresAt before the sweeper asks orders
RESERVATION_EXTEND_SEC=300       # extension applied when orders reports the checkout still AWAITING_PAYMENT
RESERVATION_SWEEP_INTERVAL_MS=60000   # reservation expiry sweeper interval
RESERVATION_RECHECK_SEC=60       # back-off before re-checking a hold the sweeper could not resolve (orders down / unknown status)
MEMBERSHIP_PENDING_TTL_SEC=900   # an idle PENDING_PAYMENT membership is reconciled with payments after this (CANCELLED unless captured)

# ---------------------------------------------------------------- orders (port 4003) -----------------
ACCEPT_WINDOW_SEC=300            # restaurant accept window after placement
CHECKOUT_TTL_SEC=900             # payment window = stock reservation TTL
FOOD_TAX_BPS=500                 # GST on food (basis points)
FEE_TAX_BPS=1800                 # GST on delivery + platform fees (basis points)
PLATFORM_FEE_PAISE=500           # per child order
GUEST_CART_TTL_DAYS=7
CHECKOUT_EXPIRY_INTERVAL_MS=30000
AUTHORIZED_GRACE_SEC=600         # AUTHORIZED (uncaptured) payment holds an expired checkout this long
CHECKOUT_RATE_LIMIT_PER_MIN=10   # per user
INTERNAL_HTTP_TIMEOUT_MS=5000
ACCEPT_TIMEOUT_INTERVAL_MS=15000 # sweeper interval: PLACED orders past acceptBy are auto-rejected (RESTAURANT_TIMEOUT)

# ---------------------------------------------------------------- payments (port 4004) ---------------
PAYMENT_PROVIDER=mock            # razorpay | mock (refused in production)
# RAZORPAY_KEY_ID: required when razorpay (public key id returned to checkout)
RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET: SECRET required when razorpay
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET: SECRET required when razorpay (X-Razorpay-Signature)
RAZORPAY_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=thali-demo-c789b0dfa3386129adbb6b8a9d969fdb   # SECRET (min 16) required when mock
PAYMENT_PROVIDER_TIMEOUT_MS=8000
PAYOUT_HOLD_DAYS=0               # earnings become available after N days
PARTNER_BASE_PAYOUT_PAISE=3000
PARTNER_PER_KM_PAISE=800
AUTHORIZED_CAPTURE_AFTER_SEC=300
REFUND_MAX_ATTEMPTS=5
REFUND_BACKOFF_BASE_MS=60000     # backoff = base * 2^(attempt-1)
REFUND_POLL_AFTER_SEC=600
REFUND_WORKER_INTERVAL_MS=5000
RECONCILE_INTERVAL_MS=60000

# ---------------------------------------------------------------- delivery (port 4005) ---------------
MAX_ACTIVE_DELIVERIES=2          # per partner
OFFER_TTL_SEC=45
OFFERS_PER_ROUND=3
DISPATCH_RADIUS_KM=3,5,8         # per round; the last value repeats
MAX_DISPATCH_ROUNDS=5
BATCH_PICKUP_RADIUS_KM=1.5
BATCH_DROP_RADIUS_KM=3
BATCH_MAX_EXTRA_MINUTES=12
LOCATION_STALE_SEC=60
DISPATCH_LOCATION_MAX_AGE_SEC=120
DISPATCH_INTERVAL_MS=5000
LOCATION_PING_INTERVAL_SEC=3
CODE_MAX_ATTEMPTS=5
PARTNER_DOC_MAX_BYTES=5242880
SIMULATOR_STEP_MS=2000           # demo simulator step

# ---------------------------------------------------------------- notifications (port 4006) ----------
SMS_PROVIDER=mock                # twilio | mock (refused in production)
TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN: SECRET (also the status-webhook signature key)
TWILIO_AUTH_TOKEN=
# TWILIO_FROM: E.164 sender, or:
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_STATUS_CALLBACK_URL: empty = $PUBLIC_API_URL/api/v1/webhooks/twilio/status
TWILIO_STATUS_CALLBACK_URL=
EMAIL_PROVIDER=mailpit           # resend | mailpit | mock (production refuses mock and mailpit)
# RESEND_API_KEY: SECRET required when resend
RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET: SECRET (whsec_...) required when resend
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Thali <no-reply@thali.local>"
MAILPIT_URL=http://localhost:8025   # local dev; compose: http://mailpit:8025
NOTIF_MAX_ATTEMPTS=6
NOTIF_RETRY_BASE_SEC=30
NOTIF_RETRY_MAX_SEC=900
NOTIF_POLL_MS=1000
NOTIF_SENDING_TIMEOUT_SEC=120
PROVIDER_TIMEOUT_MS=10000
SSE_HEARTBEAT_MS=20000
SSE_MAX_AGE_SEC=3600
SSE_MAX_STREAMS_PER_USER=5

# ---------------------------------------------------------------- gateway (port 8080) ----------------
# Provider labels for /api/v1/meta are taken from the *_PROVIDER values above.
BRAND_NAME=Thali
UPSTREAM_TIMEOUT_MS=15000
HEALTH_TIMEOUT_MS=3000
RATE_LIMIT_GLOBAL_PER_MIN=300    # per IP
RATE_LIMIT_DISCOVERY_PER_MIN=60  # per IP
RATE_LIMIT_OTP_PER_MIN=10        # per IP
