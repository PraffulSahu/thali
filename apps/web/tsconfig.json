{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "paths": {
      "@thali/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@thali/pricing": [
        "../../packages/pricing/src/index.ts"
      ]
    },
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
